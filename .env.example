# Application
ENVIRONMENT=development
DEBUG=false
APP_VERSION=0.1.0
AUTO_CREATE_SCHEMA=false
MAX_UPLOAD_BYTES=10485760

# Local development defaults: metadata and raw files stay under ./data.
DATABASE_URL=sqlite:///./data/redlake.db
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./data/object-store

# Docker Compose overrides these values to use PostgreSQL and MinIO.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=redlake
S3_SECRET_KEY=redlake-secret
S3_BUCKET=redlake-raw
S3_REGION=us-east-1
